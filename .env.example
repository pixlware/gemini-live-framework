# Gemini Live Framework — Environment Configuration Example
# Copy this file to .env and configure the variables.

# ── Application Configuration ──
APP_NAME="Gemini Live Framework"
DEBUG_MODE=true
LOG_LEVEL=INFO

# ── Server Configuration ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ── Google Cloud / Vertex AI Configuration ──
# GCP Project ID is required to connect to Vertex AI
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# GCP Location/Region for auto-detection (optional)
GOOGLE_CLOUD_LOCATION=""

# Vertex AI Location where the Live Session endpoint is hosted
GEMINI_LOCATION="us-central1"

# The Gemini Live model version to use
GEMINI_LIVE_MODEL="gemini-live-2.5-flash-native-audio"

# Path to explicit GCP service account credentials JSON file.
# Leave blank/unset to fallback to Application Default Credentials (ADC).
GOOGLE_APPLICATION_CREDENTIALS=""

# ── Logging & Telemetry Configuration ──
CLOUD_LOGGING_ENABLED=false
GCS_BUCKET_NAME=""

# ONNX intra/inter op thread cap for DeepFilterNet (0 = libraries default)
DFN_THREAD_LIMIT=0

# Telemetry mode: "disabled", "local", or "cloud"
TELEMETRY_MODE=disabled
